{
  // =========================================================================
  //  tsconfig.evidence.json — THE EVIDENCE LAB
  //
  //  This configuration compiles ONLY the `*.tsc-error.ts` files, which are
  //  full of deliberate, *unsuppressed* type errors.
  //
  //  Purpose: a teaching project must never assert "the compiler says X".
  //  It must show the compiler saying X. `npm run evidence` runs this config
  //  and prints the raw diagnostics — message text and TSxxxx code included.
  //
  //  For this point the lab does double duty: several specimens are here to
  //  produce NO diagnostic at all. A swap between two same-typed parameters is
  //  accepted in silence, and the lab's job is to show that silence as
  //  rigorously as it shows an error.
  //
  //  Expected result: this compilation FAILS. That failure is the deliverable.
  // =========================================================================
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.tsc-error.ts"],
  "exclude": []
}
