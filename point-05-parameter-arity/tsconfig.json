{
  // =========================================================================
  //  tsconfig.json — the *contract* between you and the type checker.
  //
  //  Concept #5 is about ONE mechanism: verifying, before a single line runs,
  //  that a call site supplies exactly the arguments a function's parameter
  //  list requires — the right COUNT (arity) and the right TYPE at each
  //  position — accounting for optional, default, and rest parameters. The
  //  flags below are annotated with (a) what each does and (b) which of this
  //  project's arity/type failure modes it closes.
  // =========================================================================
  "compilerOptions": {
    // ---------------------------------------------------------------------
    // 1. LANGUAGE + EMIT TARGET
    // ---------------------------------------------------------------------
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "outDir": "dist",
    "rootDir": "src",

    "declaration": true,
    "sourceMap": true,

    // ---------------------------------------------------------------------
    // 2. STRICTNESS — the `strict` family, spelled out
    // ---------------------------------------------------------------------
    "strict": true,

    // Distinguishes "a parameter's declared type" from "a parameter's
    // declared type, plus undefined" — the mechanism behind demo 04
    // (undefined explicitly passed vs. a parameter genuinely omitted) and
    // demo 05 (optional parameters, T | undefined under the hood).
    "strictNullChecks": true,

    // Function PARAMETERS are checked contravariantly (demo 16) instead of
    // bivariantly — the correct, sound direction for plain function types.
    // (Method syntax keeps a deliberate bivariant hole; see demo 16.)
    "strictFunctionTypes": true,

    // `.call` / `.apply` / `.bind` are typed against the callee's real
    // parameter list, instead of accepting `any[]` — relevant to demo 15,
    // where `.apply` with an untyped array is one of the soundness holes.
    "strictBindCallApply": true,

    "strictPropertyInitialization": true,
    "noImplicitThis": true,

    // An unannotated parameter would otherwise become `any`, which accepts
    // any arity/type combination silently — reopening exactly the hole
    // demo 15 dissects. This flag closes it by default everywhere else.
    "noImplicitAny": true,

    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,

    // ---------------------------------------------------------------------
    // 3. BEYOND `strict`
    // ---------------------------------------------------------------------
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,

    // ---------------------------------------------------------------------
    // 4. SYNTAX / EMIT DISCIPLINE
    // ---------------------------------------------------------------------
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true

    // ---------------------------------------------------------------------
    // 5. DELIBERATELY *NOT* ENABLED
    //
    //   "noUnusedLocals" / "noUnusedParameters":
    //     Several demos declare proof-only bindings such as
    //         const _typed: Fn = value;
    //     whose entire purpose is to exist and type-check. In production
    //     code you should turn both on; here they would delete the evidence.
    // ---------------------------------------------------------------------
  },

  "include": ["src/**/*.ts"],

  // `*.tsc-error.ts` files are the evidence lab: real, unsuppressed type
  // errors on purpose, compiled separately by tsconfig.evidence.json so that
  // `npm run build` stays green and every demo remains executable.
  "exclude": ["src/**/*.tsc-error.ts", "dist", "node_modules"]
}
