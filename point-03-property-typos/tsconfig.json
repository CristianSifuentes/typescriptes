{
  // =========================================================================
  //  tsconfig.json — the *contract* between you and the type checker.
  //
  //  Concept #3 is entirely about ONE mechanism: verifying that every property
  //  you read or write actually exists on the declared shape of its object.
  //  The flags below are annotated with (a) what each does and (b) which of
  //  the demos in this project would silently pass without it.
  // =========================================================================
  "compilerOptions": {
    // ---------------------------------------------------------------------
    // 1. LANGUAGE + EMIT TARGET
    // ---------------------------------------------------------------------
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "outDir": "dist",
    "rootDir": "src",

    "declaration": true,
    "sourceMap": true,

    // ---------------------------------------------------------------------
    // 2. STRICTNESS — the `strict` family, spelled out
    // ---------------------------------------------------------------------
    "strict": true,

    // `null`/`undefined` become real, checkable members of a type instead of
    // silently inhabiting every property. Without this, `user.address` could
    // be `undefined` and `.city` on it would type-check anyway.
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,

    // A property with no inferable type would otherwise become `any`, which
    // reopens every typo this project exists to close — `any` has no members
    // to check a property name against.
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,

    // ---------------------------------------------------------------------
    // 3. BEYOND `strict` — flags that sharpen property-name checking
    //    specifically. This is the heart of Concept #3's tsconfig.
    // ---------------------------------------------------------------------

    // `arr[i]` is `T | undefined`, not `T`. Relevant here because index
    // signatures (demo 07) are the one place a typo can still slip through —
    // this flag at least forces you to prove the *value* exists, even though
    // it cannot tell you whether the *key* was spelled correctly.
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Distinguishes "the optional property is absent" from "the optional
    // property is present and holds `undefined`" — the two states JSON and
    // JavaScript conflate (demo 04).
    "exactOptionalPropertyTypes": true,

    // Property access through an INDEX SIGNATURE (`obj[key]`) must use
    // bracket notation; dot notation is reserved for DECLARED members. This
    // makes "this key might not exist" visible at the call site instead of
    // reading exactly like a checked, declared property (demo 07).
    "noPropertyAccessFromIndexSignature": true,

    // ---------------------------------------------------------------------
    // 4. SYNTAX / EMIT DISCIPLINE
    // ---------------------------------------------------------------------
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true

    // ---------------------------------------------------------------------
    // 5. DELIBERATELY *NOT* ENABLED
    //
    //   "noUnusedLocals" / "noUnusedParameters":
    //     Several demos declare proof-only bindings such as
    //         const _typed: Order = value;
    //     whose entire purpose is to exist and type-check. In production code
    //     you should turn both on; here they would delete the evidence.
    // ---------------------------------------------------------------------
  },

  "include": ["src/**/*.ts"],

  // `*.tsc-error.ts` files are the evidence lab: real, unsuppressed type
  // errors on purpose, compiled separately by tsconfig.evidence.json so that
  // `npm run build` stays green and every demo remains executable.
  "exclude": ["src/**/*.tsc-error.ts", "dist", "node_modules"]
}
